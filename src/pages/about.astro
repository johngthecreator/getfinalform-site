---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About — FinalForm";
const description =
  "FinalForm is a wellness brand building free tools to help you monitor your health, and eventually personalizing your health journey around what you need.";
---

<BaseLayout title={title} description={description} path="/about/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">About FinalForm</p>
      <h1>Your health shouldn't require a subscription to understand.</h1>
      <p class="hero-sub">
        We build free, private tools that help you monitor your wellness — and
        we're working toward products that personalize your health journey
        around what's actually right for you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-manifesto">
        <h2>Cheap software is honest software.</h2>
        <p>
          FinalForm is an e-commerce wellness brand with a simple idea: the tools
          you use every day to monitor your health should be free.
        </p>
      </div>

      <div class="grid grid-3 about-columns">
        <div class="about-col">
          <p class="eyebrow">What we're building</p>
          <p>
            By keeping them local-first and cheap to run, we can offer them
            without ads, subscriptions, or selling your data. Beyond the free
            tools, we're building products that let you personalize your health
            journey — so your wellness routine fits the way you actually live.
          </p>
        </div>
        <div class="about-col">
          <p class="eyebrow">How it works</p>
          <p>
            Sign up with your email to get access to the free tools as they're
            ready. It's that simple — no account, no paywall, no fine print.
          </p>
        </div>
        <div class="about-col">
          <p class="eyebrow">Our principles</p>
          <p>
            Private by default. Free by design. And honest about what your
            health data is worth — because it's yours, not a product.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Get access.</h2>
      <a href="/#signup" class="btn btn-primary btn-lg">Sign up with your email</a>
    </div>
  </section>
</BaseLayout>
