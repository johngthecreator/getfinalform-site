---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — FinalForm" description="Page not found." path="/404/">
  <section class="hero">
    <div class="container">
      <h1>That page doesn't exist.</h1>
      <p class="hero-sub">The link may be wrong, or the page may have moved.</p>
      <div class="hero-actions">
        <a href="/" class="btn btn-primary btn-lg">Back home</a>
        <a href="/#signup" class="btn btn-secondary btn-lg">Get access</a>
      </div>
    </div>
  </section>
</BaseLayout>
