---
import BaseLayout from "../../layouts/BaseLayout.astro";

const appUrl = "https://mylittlegymbro.getfinalform.com";
const title = "MyLittleGymBro — a free AI macro tracker";
const description =
  "A free, private, AI-assisted macro tracker. Scan barcodes, weigh your home-cooked meals, and ask AI about anything you eat. Per-gram accuracy, no subscription.";
---

<BaseLayout title={title} description={description} path="/products/mylittlegymbro/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">MyLittleGymBro</p>
      <h1>A free AI macro tracker — because no one should have to pay to remember the food they ate.</h1>
      <p class="hero-sub">
        Scan groceries, weigh your home-cooked meals, and ask AI about anything
        you eat. No accounts, no ads, no cloud database.
      </p>
      <div class="hero-actions">
        <a href={appUrl} class="btn btn-primary btn-lg" rel="noopener">Open the app</a>
        <a href="#features" class="btn btn-secondary btn-lg">See how it works</a>
      </div>
    </div>
  </section>

  <section id="features" class="section-tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>Free, private, and built to fix what other trackers get wrong.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3 style="font-size: 1.25rem">Scan barcodes</h3>
          <p class="muted mt-2">
            Instant macros from any package, powered by the free Open Food Facts
            database.
          </p>
        </div>
        <div class="card card-cream">
          <h3 style="font-size: 1.25rem">Per-gram meals</h3>
          <p class="muted mt-2">
            Weigh your ingredients and get calories per gram of the finished
            dish.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: 1.25rem">Ask the AI</h3>
          <p class="muted mt-2">
            Web-search any food or restaurant order and log it in one tap.
          </p>
        </div>
        <div class="card card-cream">
          <h3 style="font-size: 1.25rem">Private</h3>
          <p class="muted mt-2">
            Everything lives in your browser. No account, no cloud, no tracking.
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: 1.25rem">Label autofill</h3>
          <p class="muted mt-2">
            Barcode not found? Photograph the label and AI pre-fills the food.
          </p>
        </div>
        <div class="card card-cream">
          <h3 style="font-size: 1.25rem">Yours</h3>
          <p class="muted mt-2">
            Export your whole library to JSON anytime. Nothing locked away.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="card">
        <h2 style="font-size: 1.5rem">Why it's free</h2>
        <p class="muted mt-2" style="max-width: 42rem">
          Deliberate trade-offs keep the cost of running this at pennies: no
          servers, no cloud database, a free open barcode database, and AI that
          uses your own key. Cheap to build and cheap to run — that's what makes
          free sustainable.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>Start tracking for free.</h2>
      <p>No subscription. No account. Just your macros.</p>
      <a href={appUrl} class="btn btn-primary btn-lg" rel="noopener">Open MyLittleGymBro</a>
    </div>
  </section>
</BaseLayout>
